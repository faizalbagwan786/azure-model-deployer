# =========================================================================
# Private Azure AI Gateway - Environment Configuration
# =========================================================================

# Secret API Key (Clients pass via 'Authorization: Bearer <key>' or 'X-API-Key')
API_KEY=sk-private-azure-key-12345

# Target Model Selection (Any HuggingFace Model ID)
# Top 2025/2026 Recommended Choices:
# 1. Qwen/Qwen2.5-1.5B-Instruct            (Fast general chat & coding)
# 2. deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B (Hot open reasoning model)
# 3. meta-llama/Llama-3.2-1B-Instruct      (Lightweight edge LLM)
# 4. HuggingFaceTB/SmolVLM-500M-Instruct    (Fast vision multimodal)
# 5. BAAI/bge-small-en-v1.5                 (Fast RAG vector embeddings)
HF_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Task Type: "chat" (default), "vlm" (vision), or "embeddings" (RAG)
TASK_TYPE=chat

# Default Max Generated Tokens
MAX_TOKENS=512

# Allowed CORS Origins (Set to "*" or specific frontend domain)
ALLOW_ORIGINS=*
